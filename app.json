{
  "expo": {
    "name": "RemindApp",
    "slug": "remind-app",
    "scheme": "remind-app",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/logoreminder_main.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F9F9F9"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.minhtc.remindapp",
      "buildNumber": "1",
      "infoPlist": {
        "NSUserNotificationUsageDescription": "Ứng dụng cần quyền thông báo để nhắc lịch công việc của bạn.",
        "NSSpeechRecognitionUsageDescription": "Cho phép RemindApp sử dụng nhận dạng giọng nói.",
        "NSMicrophoneUsageDescription": "Cho phép RemindApp sử dụng micro để ghi âm giọng nói.",
        "NSPhotoLibraryUsageDescription": "Ứng dụng cần truy cập thư viện ảnh để bạn có thể tải lên và đính kèm hình ảnh.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.minhtc.remindapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logoreminder_foreground.png",
        "backgroundColor": "#E3F2FD"
      },
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/logoreminder_foreground.png",
          "color": "#1A73E8",
          "defaultChannel": "reminders",
          "sounds": []
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Cho phép RemindApp sử dụng micro để ghi âm giọng nói.",
          "speechRecognitionPermission": "Cho phép RemindApp sử dụng nhận dạng giọng nói.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "539e65f2-0e38-4cae-bfeb-963833635167"
      }
    }
  }
}